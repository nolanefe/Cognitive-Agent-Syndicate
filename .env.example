# Environment Variables
LOG_LEVEL=INFO

# Provider configuration
PROVIDER=mock
MODEL=mock-model
TEMPERATURE=0.0
MAX_OUTPUT_CHARS=50000
MAX_GENERATED_FILES=20
MAX_REPAIR_ATTEMPTS=1
ARTIFACT_OUTPUT_DIR=generated_artifacts
REQUEST_TIMEOUT=60
MAX_OUTPUT_TOKENS=4096

# Optional API keys (never commit real values)
# OPENAI_API_KEY takes precedence over API_KEY when both are set.
OPENAI_API_KEY=
API_KEY=
