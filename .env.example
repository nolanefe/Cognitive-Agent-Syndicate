# Environment Variables
LOG_LEVEL=INFO

# Provider configuration (Stage 1 defaults to the offline mock provider)
PROVIDER=mock
MODEL=mock-model
TEMPERATURE=0.0
MAX_OUTPUT_CHARS=50000
MAX_GENERATED_FILES=20
MAX_REPAIR_ATTEMPTS=1
ARTIFACT_OUTPUT_DIR=generated_artifacts

# Optional API key for future live providers (not required for Stage 1)
API_KEY=
